<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <LangVersion>10.0</LangVersion>
    <AssemblyName>JunimaticGreenhouseWorkers</AssemblyName>
    <RootNamespace>Yousv.JunimaticGreenhouseWorkers</RootNamespace>
    <GamePath>D:\Steam\steamapps\common\Stardew Valley</GamePath>
    <EnableHarmony>true</EnableHarmony>
    <EnableModDeploy>false</EnableModDeploy>
    <EnableModZip>false</EnableModZip>
    <Version>1.0.0</Version>
    <Authors>Yousv</Authors>
    <DebugType>none</DebugType>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Pathoschild.Stardew.ModBuildConfig" Version="4.1.1" />
  </ItemGroup>
  <Target Name="DeployToModsTesting" AfterTargets="Build">
    <Copy SourceFiles="$(TargetDir)JunimaticGreenhouseWorkers.dll" DestinationFolder="D:\Steam\steamapps\common\Stardew Valley\mods-testing\Junimatic Greenhouse Workers" ContinueOnError="True" />
    <Copy SourceFiles="$(ProjectDir)manifest.json" DestinationFolder="D:\Steam\steamapps\common\Stardew Valley\mods-testing\Junimatic Greenhouse Workers" ContinueOnError="True" />
  </Target>
</Project>
